<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>The Art of Belonging — Flipbook</title>
<style>
  :root{
    --stage-bg: #141414;
    --ui-color: #141414;
    --accent: #e6007e;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0; padding:0; height:100%;
    background: transparent;
    font-family: Georgia, 'Times New Roman', serif;
    color: var(--ui-color);
    overflow:hidden;
  }
  body{
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    height:100vh; gap:16px;
  }
  h1{
    font-size: 14px;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: normal;
    color: #555;
    margin: 0;
  }
  #book-outer{
    position:relative;
    width: min(92vw, 1300px, calc((100vh - 160px) * 1.525));
    aspect-ratio: 1.525;
    perspective: 2600px;
  }
  #stage{
    position:absolute; inset:0;
    background: var(--stage-bg);
    border-radius: 4px;
    box-shadow: 0 8px 20px rgba(0,0,0,.35);
    overflow:hidden;
  }
  .spine-shadow{
    position:absolute; top:0; bottom:0; left:50%;
    width: 40px; margin-left:-20px;
    background: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,.35) 50%, rgba(0,0,0,0) 100%);
    pointer-events:none;
    z-index: 5;
  }
  .half{
    position:absolute; top:0; bottom:0; width:50%;
    display:flex; align-items:center; justify-content:center;
    overflow:hidden; background:#f4f4f4;
  }
  .half.left{ left:0; justify-content:flex-end; }
  .half.right{ left:50%; justify-content:flex-start; }
  .half img{ height:100%; width:100%; object-fit:cover; display:block; }

  .single-wrap{
    position:absolute; inset:0;
    display:flex; align-items:center; justify-content:center;
    background: var(--stage-bg);
  }
  .single-wrap img{
    height:100%; object-fit:contain;
    box-shadow: 0 0 12px rgba(0,0,0,.3);
  }

  /* flip leaf elements */
  .leaf{
    position:absolute; top:0; bottom:0;
    transform-style:preserve-3d;
    z-index: 20;
  }
  .leaf .face{
    position:absolute; inset:0;
    backface-visibility:hidden;
    overflow:hidden;
    display:flex; align-items:center; justify-content:center;
  }
  .leaf .face img{ height:100%; width:100%; object-fit:cover; display:block; }
  .leaf .face.single-face img{ width:auto; object-fit:contain; }

  .leaf.right-half{ left:50%; width:50%; transform-origin: left center; }
  .leaf.left-half{ left:0; width:50%; transform-origin: right center; }
  .leaf.full{ left:0; width:100%; }
  .leaf.full.origin-left{ transform-origin: left center; }
  .leaf.full.origin-right{ transform-origin: right center; }

  .incoming{
    position:absolute; top:0; bottom:0; width:50%;
    z-index: 10; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
    background:#f4f4f4;
  }
  .incoming img{ height:100%; width:100%; object-fit:cover; display:block;}
  .incoming.right-pos{ left:50%; }
  .incoming.left-pos{ left:0; }

  .leaf.flipping{
    transition: transform 0.85s cubic-bezier(.65,.05,.36,1);
    box-shadow: 0 0 12px rgba(0,0,0,.25);
  }

  #controls{
    display:flex; align-items:center; gap:22px;
    color:#444; font-size:14px; letter-spacing:1px;
  }
  #controls button{
    background:none; border:1px solid #bbb; color:#333;
    font-family: inherit; font-size:20px; width:42px; height:42px;
    border-radius:50%; cursor:pointer; transition: all .2s;
    display:flex; align-items:center; justify-content:center;
  }
  #controls button:hover:not(:disabled){ background:var(--accent); border-color:var(--accent); color:#fff; }
  #controls button:disabled{ opacity:.25; cursor:default; }
  #counter{ min-width: 90px; text-align:center; }

  .clickzone{
    position:absolute; top:0; bottom:0; width:15%; z-index:30; cursor:pointer;
  }
  .clickzone.cz-left{ left:0; }
  .clickzone.cz-right{ right:0; }

  #hint{
    font-size:11px; color:#999; letter-spacing:1px;
  }
</style>
</head>
<body>

  <h1>The Art of Belonging &nbsp;·&nbsp; Khloe Rios-Wyatt</h1>

  <div id="book-outer">
    <div id="stage">
      <div class="spine-shadow" id="spineShadow"></div>
      <div id="staticView"></div>
    </div>
    <div class="clickzone cz-left" id="czLeft"></div>
    <div class="clickzone cz-right" id="czRight"></div>
  </div>

  <div id="controls">
    <button id="prevBtn" title="Previous">&#8249;</button>
    <span id="counter">1 / 11</span>
    <button id="nextBtn" title="Next">&#8250;</button>
  </div>

<script>
const IMAGES = {"1": "data:image/jpeg;base64,", "2a": "data:image/jpeg;base64,", "2b": "data:image/jpeg;base64,", "3": "data:image/jpeg;base64,", "4": "data:image/jpeg;base64,", "5a": "data:image/jpeg;base64,", "5b": "data:image/jpeg;base64,", "6a": "data:image/jpeg;base64,", "6b": "data:image/jpeg;base64,", "7a": "data:image/jpeg;base64,", "7b": "data:image/jpeg;base64,", "8a": "data:image/jpeg;base64,", "8b": "data:image/jpeg;base64,", "9a": "data:image/jpeg;base64,", "9b": "data:image/jpeg;base64,", "10a": "data:image/jpeg;base64,", "10b": "data:image/jpeg;base64,", "11a": "data:image/jpeg;base64,", "11b": "data:image/jpeg;base64,", "12": "data:image/jpeg;base64,"};

// Each entry: {type:'single', img:'1'} or {type:'double', left:'2a', right:'2b'}
const spreads = [
  {type:'single', img:'1'},
  {type:'double', left:'2a', right:'2b'},
  {type:'double', left:'3',  right:'4'},
  {type:'double', left:'5a', right:'5b'},
  {type:'double', left:'6a', right:'6b'},
  {type:'double', left:'7a', right:'7b'},
  {type:'double', left:'8a', right:'8b'},
  {type:'double', left:'9a', right:'9b'},
  {type:'double', left:'10a', right:'10b'},
  {type:'double', left:'11a', right:'11b'},
  {type:'single', img:'12'}
];

let current = 0;
let animating = false;

const staticView = document.getElementById('staticView');
const stage = document.getElementById('stage');
const spineShadow = document.getElementById('spineShadow');
const counter = document.getElementById('counter');
const prevBtn = document.getElementById('prevBtn');
const nextBtn = document.getElementById('nextBtn');

function imgTag(name, extraClass){
  return '<img src="' + IMAGES[name] + '" class="' + (extraClass||'') + '">';
}

function renderStatic(spread){
  spineShadow.style.display = spread.type === 'double' ? 'block' : 'none';
  if(spread.type === 'single'){
    staticView.innerHTML = '<div class="single-wrap">' + imgTag(spread.img) + '</div>';
  } else {
    staticView.innerHTML =
      '<div class="half left">' + imgTag(spread.left) + '</div>' +
      '<div class="half right">' + imgTag(spread.right) + '</div>';
  }
}

function updateControls(){
  counter.textContent = (current+1) + ' / ' + spreads.length;
  prevBtn.disabled = current === 0 || animating;
  nextBtn.disabled = current === spreads.length-1 || animating;
}

function faceContent(spread, side){
  // side: 'left' or 'right' — returns html for that half of a given spread
  if(spread.type === 'single'){
    return imgTag(spread.img, 'single-face-img');
  }
  return imgTag(spread[side]);
}

function goNext(){
  if(animating || current >= spreads.length-1) return;
  const cur = spreads[current];
  const tgt = spreads[current+1];
  animating = true;
  updateControls();

  if(cur.type === 'single' || tgt.type === 'single'){
    fullFlip('next', cur, tgt);
  } else {
    halfFlipNext(cur, tgt);
  }
}

function goPrev(){
  if(animating || current <= 0) return;
  const cur = spreads[current];
  const tgt = spreads[current-1];
  animating = true;
  updateControls();

  if(cur.type === 'single' || tgt.type === 'single'){
    fullFlip('prev', cur, tgt);
  } else {
    halfFlipPrev(cur, tgt);
  }
}

function finishTransition(newIndex){
  current = newIndex;
  renderStatic(spreads[current]);
  animating = false;
  updateControls();
}

// ---- Half-page book-style flip (double <-> double) ----
function halfFlipNext(cur, tgt){
  const incoming = document.createElement('div');
  incoming.className = 'incoming right-pos';
  incoming.innerHTML = imgTag(tgt.right);
  stage.appendChild(incoming);

  const leaf = document.createElement('div');
  leaf.className = 'leaf right-half';
  leaf.innerHTML =
    '<div class="face front">' + imgTag(cur.right) + '</div>' +
    '<div class="face back" style="transform:rotateY(180deg);">' + imgTag(tgt.left) + '</div>';
  stage.appendChild(leaf);

  requestAnimationFrame(()=>{
    leaf.classList.add('flipping');
    requestAnimationFrame(()=>{ leaf.style.transform = 'rotateY(-180deg)'; });
  });

  leaf.addEventListener('transitionend', function te(){
    leaf.removeEventListener('transitionend', te);
    incoming.remove();
    leaf.remove();
    finishTransition(current+1);
  }, {once:true});
}

function halfFlipPrev(cur, tgt){
  const incoming = document.createElement('div');
  incoming.className = 'incoming left-pos';
  incoming.innerHTML = imgTag(tgt.left);
  stage.appendChild(incoming);

  const leaf = document.createElement('div');
  leaf.className = 'leaf left-half';
  leaf.innerHTML =
    '<div class="face front">' + imgTag(cur.left) + '</div>' +
    '<div class="face back" style="transform:rotateY(-180deg);">' + imgTag(tgt.right) + '</div>';
  stage.appendChild(leaf);

  requestAnimationFrame(()=>{
    leaf.classList.add('flipping');
    requestAnimationFrame(()=>{ leaf.style.transform = 'rotateY(180deg)'; });
  });

  leaf.addEventListener('transitionend', function te(){
    leaf.removeEventListener('transitionend', te);
    incoming.remove();
    leaf.remove();
    finishTransition(current-1);
  }, {once:true});
}

// ---- Full-stage flip (used whenever a single cover page is involved) ----
function fullFlip(direction, cur, tgt){
  const origin = direction === 'next' ? 'origin-left' : 'origin-right';
  const leaf = document.createElement('div');
  leaf.className = 'leaf full ' + origin;

  const frontHtml = cur.type === 'single'
    ? '<div class="face front single-face">' + imgTag(cur.img) + '</div>'
    : '<div class="face front">' +
        '<div class="half left">' + imgTag(cur.left) + '</div>' +
        '<div class="half right">' + imgTag(cur.right) + '</div>' +
      '</div>';

  const backRotate = direction === 'next' ? 180 : -180;
  const backHtml = tgt.type === 'single'
    ? '<div class="face back single-face" style="transform:rotateY(' + backRotate + 'deg);">' + imgTag(tgt.img) + '</div>'
    : '<div class="face back" style="transform:rotateY(' + backRotate + 'deg);">' +
        '<div class="half left">' + imgTag(tgt.left) + '</div>' +
        '<div class="half right">' + imgTag(tgt.right) + '</div>' +
      '</div>';

  leaf.innerHTML = frontHtml + backHtml;
  stage.appendChild(leaf);

  const targetDeg = direction === 'next' ? -180 : 180;

  requestAnimationFrame(()=>{
    leaf.classList.add('flipping');
    requestAnimationFrame(()=>{ leaf.style.transform = 'rotateY(' + targetDeg + 'deg)'; });
  });

  leaf.addEventListener('transitionend', function te(){
    leaf.removeEventListener('transitionend', te);
    leaf.remove();
    finishTransition(direction === 'next' ? current+1 : current-1);
  }, {once:true});
}

document.getElementById('nextBtn').addEventListener('click', goNext);
document.getElementById('prevBtn').addEventListener('click', goPrev);
document.getElementById('czLeft').addEventListener('click', goPrev);
document.getElementById('czRight').addEventListener('click', goNext);
document.addEventListener('keydown', (e)=>{
  if(e.key === 'ArrowRight') goNext();
  if(e.key === 'ArrowLeft') goPrev();
});

renderStatic(spreads[current]);
updateControls();
</script>
</body>
</html>
